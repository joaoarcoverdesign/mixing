{
  "rewrites": [
    { "source": "/pipeline", "destination": "/pipeline.html" }
  ],
  "redirects": [
    { "source": "/about.html", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/", "permanent": true },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mixing-pearl.vercel.app" }],
      "destination": "https://abdalladesign.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mixing-pearl.vercel.app" }],
      "destination": "https://abdalladesign.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mixing-jbdalla-gmailcoms-projects.vercel.app" }],
      "destination": "https://abdalladesign.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mixing-jbdalla-gmailcoms-projects.vercel.app" }],
      "destination": "https://abdalladesign.vercel.app/:path*",
      "permanent": true
    }
  ]
}
